{
  "name": "rag-neo4j-students",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --inspect --env-file=.env src/index.ts",
    "seed": "node --watch --env-file=.env data/seed.ts",
    "seed:once": "node --env-file=.env data/seed.ts",
    "test": "node --env-file=.env --test tests/*.test.ts",
    "test:e2e": "node --env-file=.env --inspect --test tests/*.test.ts",
    "test:dev": "node --env-file=.env --watch --test tests/*.test.ts",
    "test:e2e:dev": "node --env-file=.env --watch --inspect --test tests/*.test.ts",
    "langgraph:serve": "langgraphjs dev",
    "docker:infra:up": "docker compose up -d --wait",
    "docker:infra:down": "docker compose down",
    "docker:infra:logs": "docker compose logs -f",
    "docker:infra:cleanup": "docker compose down --volumes --remove-orphans && rm -rf storage"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "fastify": "^5.6.1",
    "langchain": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^0.0.41",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
